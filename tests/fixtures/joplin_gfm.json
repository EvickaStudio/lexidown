      "html": "<div class=\"example highlight-text-html extra\"><pre>&lt;h1&gt;x&lt;/h1&gt;\n</pre></div>",
      "options": {
        "fence": "~~~~"
      },
      "expected": "~~~~html\n<h1>x</h1>\n\n~~~~"
    },
    {
      "name": "highlight language pattern stops at punctuation",
      "plugin": "highlightedCodeBlock",
      "html": "<div class=\"highlight-source-c++\"><pre>a &lt; b</pre></div>",
      "options": {},
      "expected": "```c\na < b\n```"
    },
    {
      "name": "highlight allows collapsed leading whitespace",
      "plugin": "highlightedCodeBlock",
