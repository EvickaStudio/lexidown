  "cases": [
    {
      "name": "all plugins together",
      "plugin": "gfm",
      "html": "<p><del>old</del> new</p><div class=\"highlight-source-python\"><pre>print(1)</pre></div><table><tr><th>Name</th><th>Value</th></tr><tr><td>a</td><td>b</td></tr></table><ul><li><input type=\"checkbox\" checked>done</li></ul>",
      "options": {},
      "expected": "~~old~~ new\n\n```python\nprint(1)\n```\n\n| Name | Value |\n| --- | --- |\n| a   | b   |\n\n*   [x] done"
    },
    {
      "name": "all strikethrough tags",
      "plugin": "strikethrough",
      "html": "<p><del>one</del> <s>two</s> <strike>three</strike></p>",
      "options": {},
      "expected": "~~one~~ ~~two~~ ~~three~~"
    },
    {
      "name": "strikethrough whitespace and nested emphasis",
      "plugin": "strikethrough",
      "html": "<p>a<del> <strong>bold</strong> </del>b <s></s></p>",
      "options": {},
      "expected": "a ~~**bold**~~ b"
    },
    {
      "name": "highlight source code",
      "plugin": "highlightedCodeBlock",
